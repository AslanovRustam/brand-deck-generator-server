OPENAI_API_KEY=sk-fake-placeholder-REPLACE-ME-1234567890
OPENAI_TEXT_MODEL=gpt-4o
# Дефолтная/резервная модель для картинок (используется всегда, кроме
# баннеров — для них фронтенд сперва пробует gpt-image-2 с произвольным
# WxH под точный размер плитки, и сервер сам откатывается на эту модель
# и штатный размер, если у ключа нет доступа к gpt-image-2).
OPENAI_IMAGE_MODEL=gpt-image-1
PORT=3000
